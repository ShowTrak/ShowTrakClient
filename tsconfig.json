{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@showtrak/protocol": ["./shared/src/index.d.ts"],
      // The runtime, common and electron-main entry points are real emitted
      // JavaScript, so they resolve to the BUILT declarations rather than to
      // source. Pointing one at shared/src instead would drag those .ts files
      // into this program, where they sit outside rootDir and fail to compile
      // (TS6059) — and would typecheck against source while Node loads dist.
      // An exact key outranks the wildcard below, which still covers the
      // ambient .d.ts protocol types.
      //
      // This requires `npm run build:shared` to have run; it is the first step
      // of `build` and also runs on postinstall.
      "@showtrak/protocol/runtime": ["./shared/dist/runtime/index.d.ts"],
      "@showtrak/protocol/common": ["./shared/dist/common/index.d.ts"],
      "@showtrak/protocol/electron-main": ["./shared/dist/electron-main/index.d.ts"],
      "@showtrak/protocol/*": ["./shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/UI/**", "test"]
}
