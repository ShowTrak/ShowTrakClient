// Test-only compilation of the renderer sources. Mirrors the Server's config of
// the same name.
//
// The shipped renderer is bundled by esbuild into one IIFE per entry point
// (dist/UI/js/app/*.js), which is neither loadable by `require()` nor meaningful
// to measure per-file. This config emits the SAME sources as individual
// CommonJS modules under dist-test/ so that `node:test` files can require them
// and c8 can report per-file coverage (with --all, untested files still appear
// at 0% rather than being invisible).
//
// dist-test/ is build output only: gitignored, excluded from the asar, and never
// shipped. It is rebuilt by `pretest`.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist-test",
    "types": ["jquery", "node"],
    "paths": {
      "@showtrak/protocol": ["./shared/src/index.d.ts"],
      "@showtrak/protocol/*": ["./shared/src/*"]
    }
  },
  "include": ["src/UI/js/app/**/*", "src/UI/types/**/*"]
}
