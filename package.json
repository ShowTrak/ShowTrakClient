{
  "name": "showtrak-client",
  "productName": "ShowTrak Client",
  "private": true,
  "version": "3.18.0",
  "description": "Simple, Free LAN PC Monitoring for arcade style environments.",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','dist-test']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "build:ts": "tsc -p tsconfig.json",
    "copy:assets": "node scripts/copy-assets.js",
    "build": "npm run clean && npm run build:shared && npm run build:ts && npm run typecheck:renderer && npm run build:renderer && npm run copy:assets",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:renderer",
    "start": "npm run build && electron-forge start",
    "premake": "npm run build",
    "make": "electron-forge make",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "publish": "node scripts/publish-release.js",
    "lint": "eslint",
    "pretest": "npm run build && npm run build:test-renderer",
    "test": "node --test",
    "pretest:coverage": "npm run build && npm run build:test-renderer",
    "test:coverage": "c8 --all --include=dist/Modules/**/*.js --include=dist/*.js --include=dist/main/**/*.js --include=dist-test/UI/js/app/**/*.js --reporter=text --reporter=text-summary --reporter=lcov node --test",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --check",
    "prepare": "husky",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "node scripts/build-renderer.js",
    "build:test-renderer": "tsc -p tsconfig.renderer.test.json",
    "probe:electron": "electron scripts/electron-api-probe.js",
    "build:shared": "tsc -p shared/tsconfig.build.json",
    "postinstall": "npm run build:shared"
  },
  "keywords": [],
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrakClient.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrakClient/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/auto-launch": "^5.0.5",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@showtrak/protocol": "file:./shared",
    "auto-launch": "^5.0.6",
    "bonjour-service": "^1.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "picocolors": "^1.1.1",
    "socket.io-client": "^4.8.3",
    "usb": "^2.18.0",
    "uuid": "^11.1.1"
  },
  "overridesComment": "node-addon-api: usb's binding.gyp compiles its N-API bindings with a hard '-std=c++14'. node-addon-api 8.8.0 added unguarded std::string_view overloads, so its headers now require C++17 and the Linux (g++) rebuild of usb fails with \"'std::string_view' has not been declared\". Apple clang and MSVC tolerate it, so only the ubuntu make job breaks. 8.7.0 is the last release that compiles under C++14 - lift this pin once usb raises its own C++ standard.",
  "overrides": {
    "node-addon-api": "8.7.0"
  }
}
