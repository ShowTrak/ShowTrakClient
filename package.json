{
  "name": "showtrak-client",
  "productName": "ShowTrak Client",
  "version": "3.14.0",
  "description": "Simple, Free LAN PC Monitoring for arcade style environments.",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','dist-test']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "build:ts": "tsc -p tsconfig.json",
    "copy:assets": "node scripts/copy-assets.js",
    "build": "npm run clean && npm run build:ts && npm run typecheck:renderer && npm run build:renderer && npm run copy:assets",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:renderer",
    "start": "npm run build && electron-forge start",
    "premake": "npm run build",
    "make": "electron-forge make",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "lint": "eslint",
    "pretest": "npm run build && npm run build:test-renderer",
    "test": "node --test",
    "pretest:coverage": "npm run build && npm run build:test-renderer",
    "test:coverage": "c8 --all --include=dist/Modules/**/*.js --include=dist/*.js --include=dist-test/UI/js/app/**/*.js --reporter=text --reporter=text-summary --reporter=lcov node --test",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --check",
    "prepare": "husky",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "node scripts/build-renderer.js",
    "build:test-renderer": "tsc -p tsconfig.renderer.test.json"
  },
  "keywords": [],
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrakClient.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrakClient/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^7.5.1",
    "@types/auto-launch": "^5.0.5",
    "@types/bonjour": "^3.5.13",
    "@types/checksum": "^0.1.35",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "electron": "37.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "~5.7",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "bonjour": "^3.5.1",
    "checksum": "^1.0.0",
    "colors": "^1.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "macaddress": "^0.5.4",
    "socket.io-client": "^4.8.3",
    "usb": "^2.15.0",
    "uuid": "^11.1.0"
  }
}
