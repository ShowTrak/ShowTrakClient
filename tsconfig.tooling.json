// Typechecks the TypeScript configs at the repo root: forge.config.ts and
// eslint.config.ts. Nothing here is compiled. Electron Forge and ESLint each load
// their config through jiti, which transpiles it on the fly, so this program is
// typecheck-only (noEmit) and part of `npm run typecheck`.
//
// `module: preserve` + bundler resolution model how jiti actually loads these
// files: ESM syntax in a package without "type": "module", importing CommonJS
// and ESM-only packages alike. Under node16 rules TypeScript would treat both
// files as CommonJS and reject the ESM-only imports (@electron/fuses,
// @electron-forge/plugin-fuses, @eslint/markdown) that jiti handles fine.
// isolatedModules matches jiti transpiling each file on its own.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["forge.config.ts", "eslint.config.ts"]
}
